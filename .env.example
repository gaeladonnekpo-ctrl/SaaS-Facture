# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais committer .env.local.

# Supabase Public & Anon Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase Server-side Secret Key (jamais préfixée par NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_ACCESS_TOKEN=sbp_...

# Brevo SMTP Configuration (Emails transactionnels OTP & réinitialisation mot de passe)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DANHOMEY Facture <contact@danhomey.africa>"

